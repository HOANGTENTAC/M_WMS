<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="M_WMS.Controls.DatePickers.WmsDatePicker">
    <Grid
        x:Name="RootGrid"
        HeightRequest="36"
        ColumnDefinitions="*,Auto,Auto">

        <Label
            Grid.Column="0"
            x:Name="PART_Text"
            VerticalOptions="Center"
            VerticalTextAlignment="Center"
            LineBreakMode="NoWrap"/>

        <Image
        x:Name="PART_Clear"
        Grid.Column="1"
        Source="close16x16.png"
        WidthRequest="16"
        HeightRequest="16"
        Margin="0,0,6,0"
        IsVisible="False"
        VerticalOptions="Center">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="Clear_Tapped"/>
            </Image.GestureRecognizers>
        </Image>
        
        <Image
            x:Name="PART_Icon"
            Grid.Column="2"
            WidthRequest="18"
            HeightRequest="18"
            Margin="6,0,0,0"
            VerticalOptions="Center"/>

    </Grid>
</ContentView>
