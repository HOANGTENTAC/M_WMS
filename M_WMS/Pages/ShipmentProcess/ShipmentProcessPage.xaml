<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="M_WMS.Pages.ShipmentProcess.ShipmentProcessPage"
             Title="ShipmentProcessPage"
             xmlns:converters="clr-namespace:M_WMS.Converters"
             xmlns:controls="clr-namespace:M_WMS.Controls.Buttons"
             xmlns:controlsSelecr="clr-namespace:M_WMS.Controls.Selects"
             xmlns:controlsBorder="clr-namespace:M_WMS.Controls.Borders"
             xmlns:controlsEntries="clr-namespace:M_WMS.Controls.Entries"
             xmlns:controlsDatePickers="clr-namespace:M_WMS.Controls.DatePickers"
             xmlns:controlsEntry="clr-namespace:M_WMS.Controls.Entries"
             xmlns:lang="clr-namespace:M_WMS.Helpers"
             xmlns:icon="clr-namespace:M_WMS.FontAwesomeIs"
             x:Name="ThisPage"
             xmlns:model="clr-namespace:M_WMS.Model"
             BackgroundColor="#F5F5F5"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootGrid">
        <Grid
            x:Name="MainLayout" 
            Padding="5"
            RowDefinitions="Auto,Auto,*,Auto">
            <!-- ================= SEARCH ================= -->

            <Border
                Grid.Row="0"
                Padding="8"
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="8">

                    <!-- Title -->
                    <Grid 
                        RowDefinitions="38"
                        ColumnDefinitions="35,*">

                        <Image
                            Grid.Column="0"
                            WidthRequest="28"
                            HeightRequest="28"
                            Source="stock_list.png"/>

                        <Label
                            Margin="10,0,0,0"
                            Grid.Column="1"
                            Text="{lang:Translate ShipmentProcess}"
                            FontSize="24"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                            TextColor="Black"/>

                        <Border HorizontalOptions="End"
                                Grid.Column="2"
                                Padding="10,0,10,0"
                                BackgroundColor="#E3F2FD"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 19"
                                HeightRequest="30">
                            <Label
                                FontSize="12"
                                Text="VietNam"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                TextColor="DodgerBlue"/>
                        </Border>
                    </Grid>

                    <!-- Search -->
                    <Grid
                        Margin="5"
                        VerticalOptions="Center"
                        Grid.Row="0"
                        ColumnDefinitions="100,*"
                        RowDefinitions="40,40,auto"
                        ColumnSpacing="10"
                        RowSpacing="0">

                        <!-- Inst No -->
                        <Label
                            VerticalTextAlignment="Center"
                            TextColor="Black"
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{lang:Translate StockSlip}"
                            VerticalOptions="Center"
                            Margin="0"/>
                        <Border
                            StrokeThickness="0"
                            StrokeShape="4"
                            BackgroundColor="#C8C8C8"
                            Grid.Row="0"
                            Grid.Column="1">
                            <Entry
                                IsEnabled="False"
                                Margin="10,0,0,0"
                                BackgroundColor="#C8C8C8"
                                TextColor="Black"
                                Text="{Binding StockSlip}"
                                Placeholder="{lang:Translate StockSlip}"
                                PlaceholderColor="#919191"
                                ClearButtonVisibility="WhileEditing"/>
                        </Border>

                        <!-- Goods -->
                        <Label
                            TextColor="Black"
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="{lang:Translate ScheduledShipDate}"
                            VerticalOptions="Center"/>
                        <controlsBorder:WmsBorder
                            Grid.Row="1"
                            Grid.Column="1"
                            BorderBottomThickness="1"
                            BorderBottomBrush="#DADADA">
                            <controlsBorder:WmsBorder.Child>
                                <controlsDatePickers:WmsDatePicker
                                    Margin="10,0,0,0"
                                    Date="{Binding ScheduledShipDate}"
                                    Placeholder="{lang:Translate SelectDate}"
                                    Format="yyyy/MM/dd"
                                    TextColor="Black"
                                    PlaceholderColor="Gray"
                                    FontSize="14"
                                    Icon="calendar.png"/>
                            </controlsBorder:WmsBorder.Child>
                        </controlsBorder:WmsBorder>

                        <Grid Grid.ColumnSpan="2"
                              Grid.Row="2">
                            <Grid RowDefinitions="*,35"
                                  ColumnDefinitions="*,*">
                                <Label
                                    Margin="0,10,0,0"
                                    TextColor="Black"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{lang:Translate OptDivisionOut}"
                                    VerticalOptions="Center"/>

                                <controlsEntry:WmsEntry 
                                    IsUnderline="True"
                                    Margin="0,0,10,0"
                                    VerticalTextAlignment="Center"
                                    Text="{Binding OptDivision}"
                                    Placeholder="{lang:Translate OptDivisionOut}"
                                    InnerPadding="0,0,0,0"
                                    CornerRadius="4" 
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    />
                                <Label
                                    Margin="0,10,0,0"
                                    TextColor="Black"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{lang:Translate Note}"
                                    VerticalOptions="Center"/>

                                <controlsEntry:WmsEntry
                                    IsUnderline="True"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalTextAlignment="Center"
                                    Text="{Binding Note}"
                                    Placeholder="{lang:Translate Note}"
                                    InnerPadding="0,0,0,0"
                                    BorderThickness="1"
                                    CornerRadius="4"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ================= INFO ================= -->
            <Grid
                RowDefinitions="Auto,Auto,*"
                Grid.Row="1"
                Margin="0,5,0,5"
                ColumnDefinitions="Auto,Auto,*">

                <Label
                    Margin="0,0,10,0"
                    TextColor="Black"
                    Text="{Binding ItemCountText}"
                    FontAttributes="Bold"
                    FontSize="18"
                    VerticalOptions="Center"/>

                <controls:IconButton
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    HeightRequest="35"
                    Grid.Column="1"
                    Text="{lang:Translate AddRow}"
                    CornerRadius="5"
                    Command="{Binding AddRowCommand}"
                    IconFontAwesome="{x:Static icon:FontAwesomeIcons.Plus}"
                    FontAwesomeSize="12"
                    FontAwesomeIconColor="White">
                </controls:IconButton>

                <Border
                    StrokeThickness="0"
                    StrokeShape="5"
                    Margin="10,0,0,0"
                    Grid.Column="2">
                    <controlsSelecr:WmsSelect
                        x:Name="cbo_InoutKu2"
                        Title="{lang:Translate Select}"
                        SearchPlaceholder="{lang:Translate Searching}"
                        DisplayMemberPath="Name"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding InoutKu2}"
                        Placeholder="{lang:Translate SelectItem}"
                        IsReadOnly="False"
                        IsEnabled="True"
                        BackgroundBrush="White"
                        PressedBackgroundBrush="#EEEEEE"
                        DisplayMargin="10,0,10,0"
                        ArrowMargin="10"
                        ItemsSource="{Binding StockTypeList}"
                        SelectedIndex="0"/>
                </Border>
            </Grid>
            <!-- ================= DATA ================= -->
            <Grid Grid.Row="2" >
                <Grid>
                    <CollectionView ItemsSource="{Binding ShipmentItems}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <!-- ===== Card 1 ===== -->

                                <Border
                                    Margin="0,0,0,12"
                                    Padding="15"
                                    BackgroundColor="White"
                                    Stroke="#DDDDDD"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="3">
                                        <!-- Header -->
                                        <Grid 
                                            RowDefinitions="38"
                                            ColumnDefinitions="*,Auto,Auto">
                                            <Grid Grid.Row="0"
                                                  ColumnDefinitions="110,*">
                                                <controlsBorder:WmsBorder
                                                    HeightRequest="38"
                                                    Grid.Column="0"
                                                    Margin="0,-6,0,0"
                                                    VerticalOptions="Center"
                                                    Padding="0"
                                                    BorderBottomBrush="White"
                                                    BorderBottomThickness="1">
                                                    <controlsBorder:WmsBorder.Child>
                                                        <Entry
                                                            TextTransform="Uppercase"
                                                            Text="{Binding GoodsCd}"
                                                            FontSize="16"
                                                            FontAttributes="Bold"
                                                            TextColor="#222222"
                                                            Unfocused="OnGoodsCdUnfocused"
                                                            Focused="OnGoodsCdFocused">
                                                        </Entry>
                                                    </controlsBorder:WmsBorder.Child>
                                                </controlsBorder:WmsBorder>
                                                <Label
                                                    Margin="0,0,15,0"
                                                    HorizontalTextAlignment="End"
                                                    VerticalTextAlignment="Center"
                                                    Grid.Column="1"
                                                    TextColor="Black"
                                                    Text="{Binding GoodsName}">
                                                    <Label.Behaviors>
                                                        <lang:DynamicFontSizeBehavior DefaultFontSize="14" MaxWidth="240" />
                                                    </Label.Behaviors>
                                                </Label>
                                            </Grid>
                                            <Border
                                                Grid.Column="2"
                                                WidthRequest="38"
                                                HeightRequest="38"
                                                Padding="0"
                                                BackgroundColor="#E3F2FD"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 19">

                                                <Image
                                                    WidthRequest="18"
                                                    HeightRequest="18"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Source="delete.png">

                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                      Path=BindingContext.DeleteRowCommand}"
                                                    CommandParameter="{Binding}" />
                                                    </Image.GestureRecognizers>

                                                </Image>

                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#EEEEEE"/>

                                        <!-- Body -->

                                        <Grid
                                            ColumnDefinitions="80,*"
                                            RowDefinitions="40,40,40,40"
                                            ColumnSpacing="10"
                                            RowSpacing="0">

                                            <!-- Stock Type -->

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Text="{lang:Translate StockType}"
                                                VerticalOptions="Center"
                                                TextColor="Black"/>

                                            <controlsBorder:WmsBorder
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Background="White"
                                                Padding="0"
                                                BorderBottomThickness="1"
                                                BorderBottomBrush="#DADADA">
                                                <controlsBorder:WmsBorder.Child>
                                                    <controlsSelecr:WmsSelect
                                                    SelectedValue="{Binding StockType}"
                                                    Placeholder="{lang:Translate StockType}"
                                                    IsReadOnly="False"
                                                    IsEnabled="True"
                                                    DisplayMemberPath="Name"
                                                    SelectedValuePath="Value"
                                                    BackgroundBrush="White"
                                                    PressedBackgroundBrush="#EEEEEE"
                                                    DisplayMargin="10,0,10,0"
                                                    ArrowMargin="10"
                                                    ItemsSource="{Binding Source={x:Reference ThisPage},
                                                                Path=BindingContext.StockKuList}"/>
                                                </controlsBorder:WmsBorder.Child>
                                            </controlsBorder:WmsBorder>

                                            <Grid
                                                Grid.ColumnSpan="2"
                                                ColumnDefinitions="*,*"
                                                Grid.Row="1">
                                                <Grid 
                                                    Margin="0,0,10,0"
                                                    Grid.Column="0"
                                                    ColumnDefinitions="60,*">
                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Text="{lang:Translate ShipmentQty}"
                                                        VerticalOptions="Center"
                                                        TextColor="Black"/>

                                                    <controlsBorder:WmsBorder
                                                        BorderBottomThickness="1"
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        BorderBottomBrush="#DADADA">
                                                        <controlsBorder:WmsBorder.Child>
                                                            <Entry
                                                                TextChanged="QtyEntry_TextChanged"
                                                                HorizontalTextAlignment="End"
                                                                Text="{Binding Qty, Mode=TwoWay,StringFormat='{0:N0}'}"
                                                                Keyboard="Numeric"
                                                                TextColor="Black"
                                                                ClearButtonVisibility="WhileEditing">
                                                            </Entry>
                                                        </controlsBorder:WmsBorder.Child>
                                                    </controlsBorder:WmsBorder>
                                                </Grid>
                                                <Grid 
                                                    Margin="10,0,0,0"
                                                    Grid.Column="1"
                                                    ColumnDefinitions="60,*">
                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Text="{lang:Translate PlanQTY}"
                                                        VerticalOptions="Center"
                                                        TextColor="Black"/>

                                                    <controlsBorder:WmsBorder
                                                        BorderBottomThickness="1"
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        BorderBottomBrush="#DADADA">
                                                        <controlsBorder:WmsBorder.Child>
                                                            <Entry
                                                                TextChanged="QtyEntry_TextChanged"
                                                                HorizontalTextAlignment="End"
                                                                Text="{Binding PlanQty, Mode=TwoWay,StringFormat='{0:N0}'}"
                                                                Keyboard="Numeric"
                                                                TextColor="Black"
                                                                ClearButtonVisibility="WhileEditing">
                                                            </Entry>
                                                        </controlsBorder:WmsBorder.Child>
                                                    </controlsBorder:WmsBorder>
                                                </Grid>
                                            </Grid>

                                            <!-- Remark -->
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Text="{lang:Translate Reason}"
                                                VerticalOptions="Center"
                                                TextColor="Black"/>
                                            <controlsBorder:WmsBorder
                                                Grid.Row="2" 
                                                Grid.Column="1"
                                                Background="White"
                                                Padding="0"
                                                BorderBottomThickness="1"
                                                BorderBottomBrush="#DADADA">
                                                <controlsBorder:WmsBorder.Child>
                                                    <controlsSelecr:WmsSelect
                                                        DisplayMemberPath="Name"
                                                        SelectedValuePath="Value"
                                                        SelectedValue="{Binding Remark}"
                                                        Placeholder="{lang:Translate Reason}"
                                                        IsReadOnly="False"
                                                        IsEnabled="True"
                                                        BackgroundBrush="White"
                                                        PressedBackgroundBrush="#EEEEEE"
                                                        DisplayMargin="10,0,10,0"
                                                        ArrowMargin="10"
                                                        ItemsSource="{Binding Source={x:Reference ThisPage},
                                                        Path=BindingContext.ReasonList}"/>
                                                </controlsBorder:WmsBorder.Child>
                                            </controlsBorder:WmsBorder>
                                            <Grid Grid.Row="3"
                                              Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              ColumnDefinitions="auto,*">
                                                <Grid Grid.Column="0"
                                                    ColumnDefinitions="auto, 130">
                                                    <Label
                                                        Text="{lang:Translate InstrNo}"
                                                        VerticalOptions="Center"
                                                        TextColor="Black"/>
                                                    <controlsBorder:WmsBorder
                                                        Margin="10,0,0,0"
                                                        Grid.Column="1"
                                                        BorderBottomThickness="1"
                                                        FocusedBorderBottomBrush="DodgerBlue"
                                                        BorderBottomBrush="#DADADA">
                                                        <controlsBorder:WmsBorder.Child>
                                                            <Entry Placeholder="{lang:Translate InstrNo}"
                                                                   TextTransform="Uppercase"
                                                                   Text="{Binding InstrNo}"
                                                                   TextColor="Black"
                                                                   ClearButtonVisibility="WhileEditing"/>
                                                        </controlsBorder:WmsBorder.Child>
                                                    </controlsBorder:WmsBorder>
                                                </Grid>
                                                <Grid Margin="5,0,0,0" 
                                                  Grid.Column="1"
                                                  ColumnDefinitions="50, *">
                                                    <Label 
                                                        Grid.Column="0"
                                                        Text="{lang:Translate Unit}"
                                                        VerticalOptions="Center"
                                                        HorizontalTextAlignment="End"
                                                        TextColor="Black"/>
                                                    <controlsBorder:WmsBorder
                                                        Grid.Column="1"
                                                        Background="White"
                                                        BorderBottomThickness="1"
                                                        BorderBottomBrush="#DADADA">
                                                        <controlsBorder:WmsBorder.Child>
                                                            <controlsSelecr:WmsSelect
                                                                DisplayMemberPath="Name"
                                                                SelectedValuePath="Value"
                                                                SelectedValue="{Binding Unit}"
                                                                Placeholder="{lang:Translate Unit}"
                                                                IsReadOnly="False"
                                                                IsEnabled="True"
                                                                BackgroundBrush="White"
                                                                PressedBackgroundBrush="#EEEEEE"
                                                                DisplayMargin="10,0,10,0"
                                                                ArrowMargin="10"
                                                                ItemsSource="{Binding Source={x:Reference ThisPage},
                                                                Path=BindingContext.UnitList}"/>
                                                        </controlsBorder:WmsBorder.Child>
                                                    </controlsBorder:WmsBorder>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>

                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
                <!-- Loading Overlay -->
                <Grid
                    IsVisible="{Binding IsLoading}"
                    BackgroundColor="#80FFFFFF"
                    InputTransparent="False"
                    ZIndex="1">
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="10">
                        <ActivityIndicator
                            IsRunning="{Binding IsLoading}"
                            Color="DodgerBlue"
                            WidthRequest="40"
                            HeightRequest="40"/>
                        <Label
                            Text="{lang:Translate Loading}"
                            FontSize="16"
                            TextColor="Black"/>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
            <!-- ================= Footer ================= -->
            <Border Grid.Row="3"
                    Padding="8"
                    BackgroundColor="White"
                    Stroke="#E0E0E0"
                    StrokeShape="RoundRectangle 12">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="auto,*,auto"
                    ColumnSpacing="8"
                    RowSpacing="0">

                    <controls:IconButton 
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                        Command="{Binding BackCommand}"
                        IconSource="previous.png"
                        Grid.Column="0"
                        Text="{lang:Translate Back}"/>

                    <Label
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        TextColor="Black"
                        Grid.Column="1"
                        Text="{Binding TotalQty,StringFormat='Total : {0}'}"/>

                    <controls:IconButton 
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                        Command="{Binding OkCommand}"
                        IconSource="check.png"
                        Grid.Column="2" 
                        Text="OK"/>
                </Grid>
            </Border>
        </Grid>
        <Grid
            x:Name="PopupHost"
            IsVisible="False"
            ZIndex="9999">

            <!-- Background -->
            <BoxView
                x:Name="PopupBackground"
                BackgroundColor="#50000000">

                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer
                    Tapped="PopupBackground_Tapped"/>
                </BoxView.GestureRecognizers>

            </BoxView>

            <!-- Chỉ dùng để căn giữa -->
            <Grid
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <!-- Chỉ lớn bằng Popup -->
                <Grid
                    x:Name="PopupContainer"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

            </Grid>

        </Grid>
    </Grid>
</ContentPage>