		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0-preview2.26190.5" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.90" />
		<PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="ZXing.Net.Maui" Version="0.5.2" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.5.2" />
	</ItemGroup>

